@inherits BusyComponentBase

@* "Play a friend online": who and how fast, create the match, go to its page (link + QR code). *@
<MudPaper Elevation="2" Class="pa-4 rounded-xl" Style="width:100%; max-width:400px;">
    <MudStack Spacing="3" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">🌐 Play a friend online</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary" Align="Align.Center">
            Invite a player directly — they get a pop-up — or send a link / QR code to anyone.
        </MudText>

        <MudSelect T="string" @bind-Value="_opponent" Label="Who" Variant="Variant.Outlined" Dense="true"
                   FullWidth="true" Disabled="_players is null">
            <MudSelectItem T="string" Value="@AnyoneWithTheLink">Anyone with the link</MudSelectItem>
            @foreach (var player in _players ?? [])
            {
                <MudSelectItem T="string" Value="@player.Username">@player.Username</MudSelectItem>
            }
        </MudSelect>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="flex-wrap">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Time per move:</MudText>
            <MudChipSet T="int" @bind-SelectedValue="_moveSeconds" SelectionMode="SelectionMode.SingleSelection">
                @foreach (var seconds in MatchLimits.MoveSecondsOptions)
                {
                    <MudChip T="int" Value="seconds" Color="Color.Primary" Variant="@ChipStyle.For(seconds == _moveSeconds)">
                        @MatchFormat.MoveTime(seconds)
                    </MudChip>
                }
            </MudChipSet>
        </MudStack>

        <BusyButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                    StartIcon="@Icons.Material.Filled.Share"
                    Busy="@IsRunning(nameof(CreateAsync))" Disabled="IsBusy" OnClick="CreateAsync">
            Create invite
        </BusyButton>
    </MudStack>
</MudPaper>
