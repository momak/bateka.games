@inherits BusyComponentBase
@using bateka.games.Shared.Contracts.Matches

@* Open online matches (your turn first). Hidden when there are none. *@
@if (_open is { Count: > 0 } && _me is not null)
{
    <MudPaper Elevation="0" Class="bateka-panel pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">🌐 Your matches</MudText>
            @foreach (var match in _open)
            {
                <MudLink Href="@MatchPageRoutes.For(match.Id)" Underline="Underline.None">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        @if (match.PlayerToMove == _me)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Your turn</MudChip>
                        }
                        <MudText Typo="Typo.body2">
                            <b>@GameNames.Of(match.Game)</b> · @MatchFormat.ListLine(match, _me)
                        </MudText>
                    </MudStack>
                </MudLink>
            }
        </MudStack>
    </MudPaper>
}
