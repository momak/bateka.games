@page "/leaderboard"
@inherits BusyComponentBase
@using bateka.games.Engine
@using bateka.games.Engine.Memory
@using bateka.games.Shared.Contracts.Games

<PageTitle>Leaderboard · Bateka games</PageTitle>

<MudStack Spacing="5">

    <PageHeader Eyebrow="Bateka games" Title="Leaderboard" Subtitle="All-time bests across every player. Your row is highlighted." />

    @* Which board: the game, then its size or difficulty *@
    <MudStack Spacing="2">
        <MudChipSet T="GameKind" SelectedValue="_game" SelectedValueChanged="OnGameChangedAsync"
                    SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
            @foreach (var game in GameNames.All)
            {
                <MudChip T="GameKind" Value="game" Color="Color.Primary" Variant="@ChipStyle.For(game == _game)">@GameNames.Of(game)</MudChip>
            }
        </MudChipSet>

        @if (_game == GameKind.Memory)
        {
            <MudChipSet T="int" SelectedValue="_pairs" SelectedValueChanged="OnPairsChangedAsync"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
                @foreach (var pairs in MemoryRules.Sizes)
                {
                    <MudChip T="int" Value="pairs" Size="Size.Small" Color="Color.Primary" Variant="@ChipStyle.For(pairs == _pairs)">@pairs pairs</MudChip>
                }
            </MudChipSet>
        }
        else if (GameNames.HasDifficulty(_game))
        {
            <MudChipSet T="Difficulty" SelectedValue="_difficulty" SelectedValueChanged="OnDifficultyChangedAsync"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
                @foreach (var difficulty in Difficulties)
                {
                    <MudChip T="Difficulty" Value="difficulty" Size="Size.Small" Color="Color.Primary" Variant="@ChipStyle.For(difficulty == _difficulty)">@difficulty</MudChip>
                }
            </MudChipSet>
        }
    </MudStack>

    @* The board *@
    @if (_board is null)
    {
        <CardSkeleton Count="1" Height="240px" MinWidth="100%" Label="Loading the board" />
    }
    else if (_board.Rows.Count == 0)
    {
        <MudPaper Elevation="0" Class="bateka-panel pa-6">
            <MudText Typo="Typo.body1" Align="Align.Center">Nobody has played @GameNames.Board(_board.Game, _board.Difficulty, _board.Pairs) yet — be the first!</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="bateka-panel">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead>
                    <tr>
                        <th class="games-board__rank">#</th>
                        <th>Player</th>
                        <th class="games-board__value">Best</th>
                        <th class="games-board__games">Games</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _board.Rows)
                    {
                        <tr class="@(row.IsMe ? "games-board__me" : null)">
                            <td class="games-board__rank">@BoardFormat.Rank(row.Rank)</td>
                            <td>@row.Player@(row.IsMe ? " (you)" : null)</td>
                            <td class="games-board__value">@BoardFormat.Value(_board.Game, row)</td>
                            <td class="games-board__games">@row.Games</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    @* Achievements *@
    <MudText Typo="Typo.h5">Achievements</MudText>

    @if (_achievements is null)
    {
        <CardSkeleton Count="6" Height="120px" MinWidth="220px" Label="Loading achievements" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @UnlockedCount / @_achievements.Count unlocked
        </MudText>

        <div class="games-achievements">
            @foreach (var achievement in _achievements)
            {
                <MudPaper Elevation="0" Class="bateka-panel">
                    <div class="@AchievementClass(achievement)">
                        <div class="games-achievement__icon">@achievement.Icon</div>
                        <div class="games-achievement__body">
                            <MudText Typo="Typo.subtitle1"><strong>@achievement.Title</strong></MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@achievement.Description</MudText>
                            @if (achievement.UnlockedAt is { } at)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">Unlocked @LocalDate(at)</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@OthersText(achievement)</MudText>
                        </div>
                    </div>
                </MudPaper>
            }
        </div>
    }

</MudStack>
