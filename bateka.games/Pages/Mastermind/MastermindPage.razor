@page "/game/mastermind"
@inherits BusyComponentBase
@implements IDisposable
@using bateka.games.Engine.Mastermind

<PageTitle>Mastermind · Bateka games</PageTitle>

<MudStack Spacing="3" AlignItems="AlignItems.Center">

    <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary">Mastermind</MudText>

    <!-- Stats -->
    @if (Stats is null)
    {
        <div class="games-stats-skeleton">
            <CardSkeleton Count="4" Height="64px" MinWidth="72px" Label="Loading your stats" />
        </div>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-3 rounded-xl" Style="width:100%; max-width:520px;">
            <MudGrid Justify="Justify.Center" Spacing="2">
                <MudItem xs="3">
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h6">@Stats.GamesPlayed</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Played</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="3">
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h6" Color="Color.Success">@Stats.SolveRate%</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Cracked</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="3">
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h6" Color="Color.Warning">@Stats.BestPoints</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Best pts</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="3">
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h6" Color="Color.Info">@Stats.AverageGuesses</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Avg guesses</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <!-- Board + its status -->
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="flex-wrap">
        <MudChip T="string" Color="Color.Primary" Icon="@Icons.Material.Filled.GridOn">@BoardText</MudChip>
        <MudChip T="string" Color="Color.Secondary" Icon="@Icons.Material.Filled.Timer">@TimeFormat.MinutesSeconds(_elapsedSeconds)</MudChip>
        <MudChip T="string" Color="Color.Default" Icon="@Icons.Material.Filled.Replay">@_game.GuessesLeft left</MudChip>
    </MudStack>

    <div class="mm-board" style="@BoardStyle">
        <div class="mm-row mm-row--secret">
            <div class="mm-pegs">
                @for (var c = 0; c < _game.Setup.Columns; c++)
                {
                    var colour = _game.RevealedCode?[c];
                    <span class="mm-peg @(colour is null ? "mm-peg--hidden" : null)" style="@PegStyle(colour)">
                        @(colour is null ? "?" : PegLabel(colour))
                    </span>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="NewGameAsync" aria-label="New game" />
        </div>

        @for (var r = 0; r < _game.Setup.Guesses; r++)
        {
            var row = r;
            <div class="mm-row @(row == CurrentRow ? "mm-row--current" : null)">
                <div class="mm-pegs">
                    @for (var c = 0; c < _game.Setup.Columns; c++)
                    {
                        var column = c;
                        var colour = PegAt(row, column);
                        <button class="mm-peg @(colour is null ? "mm-peg--empty" : null)" style="@PegStyle(colour)"
                                disabled="@(row != CurrentRow || colour is null)"
                                aria-label="@PegName(colour)"
                                @onclick="() => ClearPeg(column)">
                            @PegLabel(colour)
                        </button>
                    }
                </div>
                <div class="mm-keys" style="@KeysStyle">
                    @foreach (var key in KeysFor(row))
                    {
                        <span class="mm-key mm-key--@key"></span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- What the dots mean -->
    <div class="mm-legend">
        <span><span class="mm-key mm-key--exact"></span> right colour, right place</span>
        <span><span class="mm-key mm-key--misplaced"></span> right colour, wrong place</span>
    </div>

    <!-- Result -->
    @if (_game.IsOver)
    {
        <MudPaper Elevation="2" Class="pa-4 rounded-xl" Style="width:100%; max-width:420px;">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                @if (_game.IsSolved)
                {
                    <MudText Typo="Typo.h6" Color="Color.Success">🎉 Cracked in @GuessesText(_game.GuessesUsed)</MudText>
                    <MudText Typo="Typo.body1"><strong>@SolvePoints pts</strong> · @TimeFormat.MinutesSeconds(_elapsedSeconds)</MudText>
                    @if (_isNewBest)
                    {
                        <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.EmojiEvents">New best!</MudChip>
                    }
                }
                else
                {
                    <MudText Typo="Typo.h6" Color="Color.Error">Out of guesses</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">The code is shown at the top.</MudText>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Replay" OnClick="NewGameAsync">
                    Play again
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    <!-- Bottom bar: options, colours, check -->
    <div class="mm-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Tune" OnClick="OpenOptions" aria-label="Options" />
        <div class="mm-palette">
            @for (var i = 0; i < _game.Setup.Colours; i++)
            {
                var colour = i;
                <button class="mm-colour" style="@PegStyle(colour)" disabled="@(!CanPick(colour))"
                        aria-label="@PegName(colour)" @onclick="() => Pick(colour)">
                    @PegLabel(colour)
                </button>
            }
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(!CanCheck)" OnClick="CheckAsync" aria-label="Check" />
    </div>

    <!-- Options -->
    <MudDialog @bind-Visible="_showOptions" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Options</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="2" Style="min-width:min(360px, 80vw);">
                <MudSwitch T="bool" @bind-Value="_draft.AllowRepeats" Color="Color.Primary" Label="Allow duplicate colours" />
                <MudSlider T="int" @bind-Value="_draft.Colours" Min="MastermindRules.MinColours" Max="MastermindRules.MaxColours" Step="1" Color="Color.Primary">
                    Colours: @_draft.Colours
                </MudSlider>
                <MudSlider T="int" @bind-Value="_draft.Columns" Min="MastermindRules.MinColumns" Max="MastermindRules.MaxColumns" Step="1" Color="Color.Primary">
                    Columns: @_draft.Columns
                </MudSlider>
                <MudSlider T="int" @bind-Value="_draft.Guesses" Min="MastermindRules.MinGuesses" Max="MastermindRules.MaxGuesses" Step="1" Color="Color.Primary">
                    Guesses: @_draft.Guesses
                </MudSlider>
                <MudSwitch T="bool" @bind-Value="_draft.ShowNumbers" Color="Color.Primary" Label="Show colour numbers" />

                @if (_draft.IsPlayable)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@WorthText(_draft)</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">Without duplicates, you need at least as many colours as columns.</MudText>
                }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="() => _showOptions = false">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_draft.IsPlayable)" OnClick="ApplyOptionsAsync">
                New game
            </MudButton>
        </DialogActions>
    </MudDialog>

</MudStack>
