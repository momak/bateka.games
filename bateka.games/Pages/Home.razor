@page "/"
@page "/game"
@inherits BusyComponentBase

<PageTitle>Games · Bateka games</PageTitle>

<MudStack Spacing="6">

    <PageHeader Eyebrow="Bateka games" Title="Pick a game" Subtitle="Classic games — beat your best, then beat everyone else's." />

    @* "ana passed you" since you last looked. Hidden when there's nothing new. *@
    @if (_notes is null)
    {
        <CardSkeleton Count="1" Height="72px" MinWidth="100%" Label="Loading your news" />
    }
    else if (_notes.Count > 0)
    {
        <MudPaper Elevation="0" Class="bateka-panel pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">📣 Since you last looked</MudText>
                    <BusyButton Variant="Variant.Text" Color="Color.Primary" Busy="@IsRunning(nameof(DismissNotesAsync))"
                                Disabled="IsBusy" OnClick="DismissNotesAsync">
                        Got it
                    </BusyButton>
                </MudStack>
                @foreach (var note in _notes)
                {
                    <MudText Typo="Typo.body2">@BoardFormat.Note(note)</MudText>
                }
                <MudLink Href="@PageRoutes.Leaderboard" Typo="Typo.body2">See the leaderboard</MudLink>
            </MudStack>
        </MudPaper>
    }

    <MudGrid Spacing="4">

        <MudItem xs="12" sm="6" md="3">
            <GameCard Title="Snake"
                      Description="Classic snake — grow your snake, avoid the walls and yourself."
                      Icon="@Icons.Material.Filled.Gamepad"
                      Href="@PageRoutes.Snake"
                      Color="#6200EA" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <GameCard Title="Memory Match"
                      Description="Flip cards and find matching pairs. Test your memory!"
                      Icon="@Icons.Material.Filled.GridView"
                      Href="@PageRoutes.Memory"
                      Color="#00BFA5" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <GameCard Title="Tic Tac Toe"
                      Description="The timeless classic. X vs O — can you beat the computer?"
                      Icon="@Icons.Material.Filled.Close"
                      Href="@PageRoutes.TicTacToe"
                      Color="#FF6D00" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <GameCard Title="Connect Four"
                      Description="Drop your discs and try to connect four in a row!"
                      Icon="@Icons.Material.Filled.GridOn"
                      Href="@PageRoutes.ConnectFour"
                      Color="#1565C0" />
        </MudItem>

    </MudGrid>

</MudStack>
