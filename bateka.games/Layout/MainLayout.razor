@inherits LayoutComponentBase

@* The shared Bateka shell (Bateka.UI): top bar, pages, light/dark, log out, account menu, busy line,
   update banner, error boundary, and the bottom tab bar on phones. games only brings its look. *@
<BatekaShell Theme="_theme"
             AppName="@AppIdentity.Name"
             AppSubtitle="@AppIdentity.Subtitle"
             HomeHref="@PageRoutes.Home"
             Links="AppNavigation.Links"
             PhoneNav="PhoneNavStyle.BottomTabs">
    <BrandMark>
        @* The app icon in small: a teal gamepad on deep purple. *@
        <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect class="brand__bg" x="0.3" y="0.3" width="31.4" height="31.4" rx="8" />
            <path class="brand__pad" d="M10.5 10.5h11c3 0 5 2.2 5.5 5.2l.8 4.6c.3 2-1.2 3.7-3.1 3.7-1.1 0-2-.5-2.6-1.4l-1.3-1.9h-9.6l-1.3 1.9c-.6.9-1.5 1.4-2.6 1.4-1.9 0-3.4-1.7-3.1-3.7l.8-4.6c.5-3 2.5-5.2 5.5-5.2z" />
            <g class="brand__keys">
                <rect x="9.6" y="13.2" width="1.8" height="5.4" rx="0.5" />
                <rect x="7.8" y="15" width="5.4" height="1.8" rx="0.5" />
                <circle cx="21" cy="14.4" r="1.15" />
                <circle cx="23.2" cy="16.6" r="1.15" />
            </g>
        </svg>
    </BrandMark>
    <ChildContent>
        @* "Ana invites you to Connect Four — Open", on any page *@
        <MatchInviteListener />
        @Body
    </ChildContent>
</BatekaShell>
