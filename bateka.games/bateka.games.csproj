<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<!-- The Blazor WebAssembly client (served by nginx behind Bateka.BFF). -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared Bateka UI, from GitHub Packages (see nuget.config in the repo root). -->
		<PackageReference Include="Bateka.UI" Version="1.3.*" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
		<!-- Online matches: live moves from games-api's hub (same version as Bateka.AI). -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
		<!-- QR code of an invite link (plain C# PNG renderer, works in WebAssembly). -->
		<PackageReference Include="QRCoder" Version="1.9.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
		<PackageReference Include="MudBlazor" Version="9.14.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The games' rules and computer opponents (plain C#, unit-tested). -->
		<ProjectReference Include="..\bateka.games.Engine\bateka.games.Engine.csproj" />
		<!-- Contracts shared with the API (requests, stats, JSON shape). -->
		<ProjectReference Include="..\bateka.games.Shared\bateka.games.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
