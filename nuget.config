<?xml version="1.0" encoding="utf-8"?>
<!-- Where packages come from. No credentials in here:
       - Visual Studio / dotnet on the PC: a PAT stored once in your user NuGet.Config (see README).
       - GitHub Actions and Docker: the NuGetPackageSourceCredentials_github environment variable,
         filled from GITHUB_TOKEN (a BuildKit secret inside Docker). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/momak/index.json" />
  </packageSources>

  <!-- Our own Bateka.* packages only ever come from GitHub; everything else only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Bateka.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
