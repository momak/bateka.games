# Copy to .env and fill in real values — .env itself is gitignored (never commit real keys).

# The shared Postgres login (same two values as bateka-shared's .env — the dedicated `bateka` role).
# The compose file builds the connection string; the database batekaGames is created on first start.
POSTGRES_USER=bateka
POSTGRES_PASSWORD=

# Must match GAMES_API_KEY in Bateka.BFF's .env — same key, two separate deployments (16+ characters).
# Generate one: [Convert]::ToBase64String((1..30 | % { Get-Random -Max 256 }))
GAMES_API_KEY=
